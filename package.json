    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "swr": "^2.5.1",
    "web-push": "^3.6.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
