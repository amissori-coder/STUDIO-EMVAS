# ---- Server e dominio (solo in produzione con Docker) ----
# Nome a dominio pubblico dell'applicazione: Caddy richiede da solo il certificato HTTPS.
DOMINIO=studio.esempio.it
# Cartella dei documenti caricati. Lasciala vuota per tenerli in ./data/uploads oppure
# indica il punto di mount di un disco aggiuntivo (es. /mnt/documenti) per poterlo ampliare.
UPLOADS_PATH=

# ---- Applicazione ----
# URL pubblico dell'app (usato per link nelle notifiche e per il callback Google)
APP_URL=http://localhost:3000
# Segreto per firmare le sessioni: OBBLIGATORIO in produzione, almeno 32 caratteri
# (genera con: openssl rand -base64 32). Vuoto = solo sviluppo (segreto non sicuro).
SESSION_SECRET=
# Cartella dati (database SQLite + documenti caricati)
DATA_DIR=./data
DATABASE_URL="file:../data/emvas.db"
# Dimensione massima upload documenti (MB)
MAX_UPLOAD_MB=25

# ---- Amministratore iniziale (creato dal seed) ----
ADMIN_EMAIL=a.missori@emvas.tax
ADMIN_NOME=Amministratore
# Se vuota, il seed genera una password casuale e la stampa a console una sola volta
ADMIN_PASSWORD=

# ---- Google (login + Gmail) ----
# Crea un progetto su https://console.cloud.google.com, abilita Gmail API,
# crea credenziali OAuth 2.0 "Web application" con redirect URI:
#   {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Se impostato, solo account Google di questo dominio possono accedere come staff
GOOGLE_ALLOWED_DOMAIN=
# Giorni di posta da importare alla prima sincronizzazione
GMAIL_SYNC_DAYS=30
# Numero massimo di messaggi per sincronizzazione
GMAIL_SYNC_MAX=300

# ---- Notifiche push (genera con: npm run vapid) ----
# La chiave pubblica entra nel bundle alla build (in Docker: docker compose up -d --build dopo averla impostata)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:studio@emvas.tax

# ---- Notifiche email (SMTP, opzionale) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Studio EMVAS <studio@emvas.tax>"

# ---- Pianificatore interno (cron) ----
ENABLE_CRON=true
# Segreto per invocare /api/cron/daily e /api/cron/gmail da un cron esterno (header Authorization: Bearer ...)
CRON_SECRET=
TZ=Europe/Rome
